{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchManagers": [
        "nix"
      ],
      "matchDepNames": [
        "!nixpkgs"
      ],
      "groupName": "Other nix inputs",
      "schedule": [
        "before 6am on friday"
      ]
    },
    {
      "matchManagers": [
        "nix"
      ],
      "matchDepNames": [
        "nixpkgs"
      ],
      "groupName": "Nixpkgs",
      "schedule": [
        "before 6am"
      ]
    },
    {
      "matchFileNames": [
        ".forgejo/workflows/**.yaml"
      ],
      "matchPackageNames": [
        "actions/checkout"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ]
}
